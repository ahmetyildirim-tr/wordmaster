rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/private/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && documentId == 'vocabulary'
        && (request.method == 'get'
          || (request.resource.data.keys().hasOnly(['data','updatedAt'])
            && request.resource.data.data is map
            && request.resource.data.data.keys().hasAll(['categories','lists','words','reviews'])
            && request.resource.data.data.categories is list
            && request.resource.data.data.lists is list
            && request.resource.data.data.words is list
            && request.resource.data.data.reviews is list
            && request.resource.data.updatedAt == request.time));
    }
    match /publicLists/{listId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['ownerUid','authorName','title','category','words','createdAt','localListId'])
        && (!('localListId' in request.resource.data) || request.resource.data.localListId is string)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 100
        && request.resource.data.words is list
        && request.resource.data.words.size() > 0
        && request.resource.data.words.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
